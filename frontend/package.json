{
  "name": "vigil-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:theme": "node scripts/theme-smoke.mjs",
    "test:theme:unit": "node --test --test-isolation=none scripts/theme-unit.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "test:observations": "node scripts/observations-smoke.mjs",
    "test:latency": "node scripts/live-latency-smoke.mjs",
    "test:latency:unit": "node --test --test-isolation=none scripts/live-latency-unit.mjs",
    "test:latency:observer": "node --test scripts/live-latency-observer-browser.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/public-sans": "^5.2.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
